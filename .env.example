# ==============================================================================
# LeaveFlow HR — Environment Configuration Example
# Copy this file to .env for local development with custom values.
# NEVER commit your real .env file or real secrets to version control.
# ==============================================================================

# Server Configuration
PORT=3000
NODE_ENV=development

# ------------------------------------------------------------------------------
# Database Configuration (PostgreSQL)
# ------------------------------------------------------------------------------
# Option A: Local Development with In-Memory PostgreSQL Emulation (pg-mem)
# When developing locally without a running PostgreSQL instance, set:
ALLOW_IN_MEMORY_DB=true
# (Leave DATABASE_URL blank when using in-memory emulation)

# Option B: Real PostgreSQL Database (Required for Production, e.g. Render / Neon / Supabase)
# DATABASE_URL=postgresql://username:password@hostname:5432/database_name
# DATABASE_SSL=false
# DATABASE_SSL_REJECT_UNAUTHORIZED=true
# DATABASE_POOL_MAX=10

# ------------------------------------------------------------------------------
# Security & Rate Limiting
# ------------------------------------------------------------------------------
# RATE_LIMIT_SECRET: Used to HMAC-SHA256 hash user identifiers for login throttling.
# - Production: REQUIRED. Must be >= 32 characters, cryptographically random, non-placeholder.
#   Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# - Development/Test: A deterministic development fallback is used if omitted.
# RATE_LIMIT_SECRET=your_32_character_cryptographically_random_secret_here

# ------------------------------------------------------------------------------
# Database Administration Guards
# ------------------------------------------------------------------------------
# ALLOW_DB_RESET: Guard for running `node backend/server.cjs --reset-db`.
# Strictly forbidden in production (startup aborts if set to true in production).
# Leave as false during normal operations.
ALLOW_DB_RESET=false
